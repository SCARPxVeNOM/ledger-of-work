node_modules/
dist/
*.tsbuildinfo
.env
.env.*
!.env.example

# spike + demo output — never commit results, receipts, or keys
out/
*.local.json
# Job output from local runs. Ignored at the root because it accumulates and is
# specific to whoever ran it — but `samples/` is committed on purpose: it is the
# receipt, the files it commits to, and a tampered twin, so anyone can reproduce
# both verdicts from this repo without buying a job first.
result*.json
result*.page.html
result*.screenshot.png
!samples/
receipt*.json

# playwright
test-results/
playwright-report/
.playwright/

.DS_Store
Thumbs.db

# Local agent/editor tooling — not part of the product
.claude/
.mcp.json
SETUP.md

# Product spec and scratch assets — publish decision left to the author
idea*.md
resourcelinks.png
.data/
apps/verify-page/dist/
apps/verify-page/dist-types/

# Browser bundles, all rebuilt by `pnpm --filter @low/web build` and by Dockerfile.web.
# Committing them would put generated blobs in every diff and let what ships drift from
# the lockfile. connect.js alone is 3.7MB of Hedera SDK and WalletConnect.
apps/web/public/connect.js
apps/web/public/app.js
apps/web/public/app.css

# Source artwork. Only the optimised WebP under public/art is committed — the PNGs are
# 1.5-2.4MB each and apps/web/optimise-art.mjs records exactly how they were reduced.
apps/web/art-src/
