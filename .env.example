# Copy to .env and fill in. Never commit .env.
# Testnet accounts: https://portal.hedera.com  (ECDSA — the Hedera x402 exact scheme
# verifies signatures against the account key, and ED25519 will fail signature recovery.)

HEDERA_NETWORK=testnet

# The service that executes jobs, owns the receipt topic, and receives payment.
SELLER_ACCOUNT_ID=0.0.
SELLER_PRIVATE_KEY=
SELLER_TOPIC_ID=

# The buying agent used by buyer-cli and the demo.
BUYER_ACCOUNT_ID=0.0.
BUYER_PRIVATE_KEY=

# Blocky402 hosted facilitator. Testnet needs no key; mainnet needs X-Api-Key: b402_<64 hex>.
FACILITATOR_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet
# FACILITATOR_API_KEY=

# Mirror node — public, keyless, read-only.
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1
