# Copy to .env and fill in. Never commit .env.
# Testnet accounts: https://portal.hedera.com  (ECDSA — the Hedera x402 exact scheme
# verifies signatures against the account key, and ED25519 will fail signature recovery.)

HEDERA_NETWORK=testnet

# The service that executes jobs, owns the receipt topic, and receives payment.
SELLER_ACCOUNT_ID=0.0.
SELLER_PRIVATE_KEY=
SELLER_TOPIC_ID=

# The buying agent used by buyer-cli and the demo.
BUYER_ACCOUNT_ID=0.0.
BUYER_PRIVATE_KEY=

# Blocky402 hosted facilitator. Testnet needs no key; mainnet needs X-Api-Key: b402_<64 hex>.
FACILITATOR_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet
# FACILITATOR_API_KEY=

# Mirror node — public, keyless, read-only.
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1

# Optional HTS payment asset. Create with `node scripts/setup-hts.mjs`.
# Buyers may pay in this token instead of HBAR; the seller advertises both.
PAYMENT_TOKEN_ID=
PAYMENT_TOKEN_DECIMALS=2

# Outstanding quotes, so a restart does not drop price commitments.
QUOTE_STORE_PATH=.data/quotes.json

# The buyer's wallet runs as its own process (`pnpm wallet`) and holds the only copy of
# BUYER_PRIVATE_KEY. The web demo calls it to sign; it never sees the key itself.
WALLET_PORT=8404
WALLET_URL=http://127.0.0.1:8404
# Shared secret. Without it, any process on this machine can ask the wallet to pay.
WALLET_TOKEN=
# Spend policy, in the asset's smallest units. The caller cannot raise these.
WALLET_MAX_PER_PAYMENT=5000000
WALLET_MAX_TOTAL=100000000
# Comma-separated. Empty means HBAR only / anyone.
WALLET_ALLOWED_ASSETS=
WALLET_ALLOWED_RECIPIENTS=

# Open feedback topic. No submit key: testers post from their own accounts, so an
# entry is attributable to them and cannot be edited or dropped by the seller.
FEEDBACK_TOPIC_ID=
