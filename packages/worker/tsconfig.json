{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    // Adapters may evaluate callbacks inside the page, where `document` and DOM types
    // are real. This does not mean the package runs in a browser — Playwright serialises
    // those callbacks and executes them in the target page.
    // DOM.Iterable is needed too: spreading a NodeList is the natural way to write these.
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "references": [{ "path": "../protocol" }],
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
