{
  "name": "ledger-of-work",
  "version": "0.1.0",
  "private": true,
  "description": "Pay-per-job access to websites that can't be turned into an API, with a receipt anyone can verify.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "spike:supported": "node scripts/supported.mjs",
    "spike:pay": "node scripts/spike-pay.mjs",
    "spike:hcs": "node scripts/spike-hcs.mjs"
  },
  "devDependencies": {
    "@hiero-ledger/sdk": "^2.87.0",
    "@types/node": "^22.10.2",
    "dotenv": "^17.4.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
