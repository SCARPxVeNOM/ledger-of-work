{
  "name": "ledger-of-work",
  "version": "0.1.0",
  "private": true,
  "description": "Pay-per-job access to websites that can't be turned into an API, with a receipt anyone can verify.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "spike:pay": "node scripts/spike-pay.mjs",
    "spike:hcs": "node scripts/spike-hcs.mjs",
    "seller": "tsx apps/seller/src/main.ts",
    "buy": "tsx apps/buyer-cli/src/main.ts",
    "verify": "tsx apps/verifier/src/main.ts",
    "smoke:worker": "tsx scripts/smoke-worker.mjs",
    "mcp": "tsx apps/mcp/src/main.ts",
    "web": "tsx apps/web/src/main.ts",
    "demo": "tsx apps/seller/src/main.ts & tsx apps/web/src/main.ts",
    "wallet": "tsx apps/wallet/src/main.ts",
    "usage": "tsx scripts/usage.mjs",
    "survey": "node scripts/survey-sites.mjs",
    "verify:page": "pnpm --filter @low/verify-page serve",
    "build:page": "pnpm --filter @low/verify-page build",
    "feedback": "tsx scripts/feedback.mjs",
    "deploy:railway": "node scripts/deploy-railway.mjs",
    "registry": "tsx scripts/registry.mjs",
    "standing-order": "tsx scripts/standing-order.mjs",
    "agent": "tsx scripts/agent-discover-and-buy.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "fonts": "node scripts/vendor-fonts.mjs"
  },
  "devDependencies": {
    "@hiero-ledger/sdk": "^2.87.0",
    "@reclaimprotocol/attestor-core": "^5.1.4",
    "@reclaimprotocol/tls": "^0.1.4",
    "@reclaimprotocol/zk-symmetric-crypto": "^5.1.6",
    "@types/node": "^22.10.2",
    "dotenv": "^17.4.2",
    "playwright": "^1.63.0",
    "snarkjs": "^0.7.6",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "@hiero-ledger/sdk": "^2.87.0"
    }
  }
}
