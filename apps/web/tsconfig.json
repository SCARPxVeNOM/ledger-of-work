{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    // This package has two halves that run in different places: `main.ts` is the demo
    // server, and `connect.ts` runs in the visitor's browser to reach their wallet. DOM
    // is here for the second. The alternative is a second tsconfig for one file, which
    // buys a stricter boundary than a three-file demo app needs.
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "references": [
    { "path": "../buyer-cli" },
    { "path": "../../packages/receipts" },
    { "path": "../../packages/worker" }
  ],
  "include": ["src/**/*.ts"]
}
